@startuml
abstract class  BaseModel{
    - Long id;
    - Date createdAt;
    - Date lastUpdatedAt;
    - State state;
}
class           Product{
    - string name;
    - string imageUrl;
    - double price;
    - string "description";
}

class           Category{
    - String title;
    - String "description";
}

enum "State" {
    ACTIVE
    INACTIVE
}

class ProductDto{
    - Long id;
    - String title;
    - String description;
    - String imageUrl;
    - Double amount;
    - Boolean isPrimeSpecific;
    - String categoryId;
}

class CategoryDto {
    - Long id;
    - String title;
    - String description;
}

class TokenHolder {
    - ThreadLocal<String> token

    + {static} void setToken(String jwt)
    + {static} String getToken()
    + {static} void clear()
}

class JwtAuthFilter{
    # void doFilterInternal()
}


BaseModel <|-- Product
Product  "many" *-right- "1"  Category : contains
BaseModel *-right- "State" : has
@enduml
